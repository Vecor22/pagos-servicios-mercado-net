@model List<Mercado.PL.GUI.DTO.Response.DeudaResponse>

@{
    ViewData["Title"] = "Deudas";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Deudas</h2>
            <div class="d-flex gap-2">
                <a asp-action="Crear" class="btn btn-primary">Nueva Deuda</a>
                <a asp-action="Exonerar" class="btn btn-warning">Exonerar</a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>CodigoDeuda</th>
                                <th>Monto</th>
                                <th>Estado</th>
                                <th>TipoGeneracion</th>
                                <th>Concepto</th>
                                <th>CodigoPuesto</th>
                                <th>Socio</th>
                                <th>FechaGeneracion</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var deuda in Model)
                                {
                                    var badgeClass = deuda.Estado == "PAGADA"
                                        ? "bg-success"
                                        : deuda.Estado == "ANULADA"
                                            ? "bg-danger"
                                            : "bg-warning text-dark";

                                    <tr>
                                        <td>@deuda.CodigoDeuda</td>
                                        <td>@deuda.Monto.ToString("0.00")</td>
                                        <td>
                                            <span class="badge @badgeClass">@deuda.Estado</span>
                                        </td>
                                        <td>@deuda.TipoGeneracion</td>
                                        <td>@deuda.Concepto</td>
                                        <td>@(string.IsNullOrWhiteSpace(deuda.CodigoPuesto) ? "-" : deuda.CodigoPuesto)</td>
                                        <td>@(string.IsNullOrWhiteSpace(deuda.Socio) ? "-" : deuda.Socio)</td>
                                        <td>@deuda.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (deuda.Estado == "PENDIENTE")
                                            {
                                                <a asp-action="Exonerar" class="btn btn-warning btn-sm">Exonerar</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin acciones</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center">No hay deudas registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
