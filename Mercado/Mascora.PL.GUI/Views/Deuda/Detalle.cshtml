@model Mercado.PL.GUI.DTO.Response.DeudaResponse

@{
    ViewData["Title"] = "Detalle de Deuda";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="card-title mb-0">Detalle de Deuda</h2>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Volver</a>
                        @if (Model.Estado == "PENDIENTE")
                        {
                            <a asp-action="Exonerar" asp-route-id="@Model.DeudaID" class="btn btn-warning">Exonerar</a>
                        }
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <tbody>
                            <tr>
                                <th class="table-light w-25">CodigoDeuda</th>
                                <td>@Model.CodigoDeuda</td>
                            </tr>
                            <tr>
                                <th class="table-light">Monto</th>
                                <td>@Model.Monto.ToString("0.00")</td>
                            </tr>
                            <tr>
                                <th class="table-light">Estado</th>
                                <td>@Model.Estado</td>
                            </tr>
                            <tr>
                                <th class="table-light">TipoGeneracion</th>
                                <td>@Model.TipoGeneracion</td>
                            </tr>
                            <tr>
                                <th class="table-light">Concepto</th>
                                <td>@Model.Concepto</td>
                            </tr>
                            <tr>
                                <th class="table-light">CodigoPuesto</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.CodigoPuesto) ? "-" : Model.CodigoPuesto)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Socio</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.Socio) ? "-" : Model.Socio)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Observacion</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.Observacion) ? "-" : Model.Observacion)</td>
                            </tr>
                            <tr>
                                <th class="table-light">FechaGeneracion</th>
                                <td>@Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th class="table-light">FechaExoneracion</th>
                                <td>@(Model.FechaExoneracion.HasValue ? Model.FechaExoneracion.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            </tr>
                            <tr>
                                <th class="table-light">MotivoExoneracion</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.MotivoExoneracion) ? "-" : Model.MotivoExoneracion)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Usuario que genero</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.UsuarioGeneracion) ? "-" : Model.UsuarioGeneracion)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Usuario que exonero</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.UsuarioExoneracion) ? "-" : Model.UsuarioExoneracion)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
