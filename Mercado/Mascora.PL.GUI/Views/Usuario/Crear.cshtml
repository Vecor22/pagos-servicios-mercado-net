@model Mercado.PL.GUI.DTO.Request.UsuarioRequest

@{
    ViewData["Title"] = "Crear Usuario";
    var roles = ViewBag.Roles as List<Mercado.BL.BE.RolBE>;
}

<h2 class="mb-4">Crear Usuario</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Crear" method="post" class="card p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label">Username</label>
        <input asp-for="Username" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input asp-for="Password" type="password" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre Completo</label>
        <input asp-for="NombreCompleto" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Foto URL</label>
        <input asp-for="FotoUrl" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Rol</label>
        <select asp-for="RolID" class="form-select" required>
            <option value="">-- Seleccione --</option>
            @foreach (var rol in roles)
            {
                <option value="@rol.RolID">@rol.Nombre</option>
            }
        </select>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>