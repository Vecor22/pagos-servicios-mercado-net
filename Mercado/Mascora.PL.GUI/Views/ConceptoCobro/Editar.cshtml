@model Mercado.PL.GUI.DTO.Request.ConceptoCobroRequest

@{
    ViewData["Title"] = "Editar Concepto de Cobro";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">Editar Concepto de Cobro</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="Editar" method="post">
                    <input type="hidden" name="id" value="@ViewBag.ConceptoCobroID" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripcion</label>
                        <input asp-for="Descripcion" class="form-control" maxlength="255" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="TipoCobro" class="form-label">TipoCobro</label>
                        <select asp-for="TipoCobro" class="form-select">
                            <option value="">-- Seleccione --</option>
                            <option value="FIJO">FIJO</option>
                            <option value="CONSUMO">CONSUMO</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
