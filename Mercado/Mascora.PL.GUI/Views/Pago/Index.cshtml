@model List<Mercado.PL.GUI.DTO.Response.PagoResponse>

@{
    ViewData["Title"] = "Pagos";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Pagos</h2>
            <a asp-action="Crear" class="btn btn-primary">Nuevo Pago</a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["Error"]
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <select name="estado" class="form-select">
                                <option value="">-- Todos --</option>
                                @if (ViewBag.Estado == "REGISTRADO")
                                {
                                    <option value="REGISTRADO" selected>REGISTRADO</option>
                                }
                                else
                                {
                                    <option value="REGISTRADO">REGISTRADO</option>
                                }
                                @if (ViewBag.Estado == "ANULADO")
                                {
                                    <option value="ANULADO" selected>ANULADO</option>
                                }
                                else
                                {
                                    <option value="ANULADO">ANULADO</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">CodigoPuesto</label>
                            <input type="text" name="codigoPuesto" class="form-control" value="@ViewBag.CodigoPuesto" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">CodigoDeuda</label>
                            <input type="text" name="codigoDeuda" class="form-control" value="@ViewBag.CodigoDeuda" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Inicio</label>
                            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Fin</label>
                            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Filtrar</button>
                            <a asp-action="Index" class="btn btn-primary">Limpiar</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>CodigoPago</th>
                                <th>CodigoDeuda</th>
                                <th>CodigoPuesto</th>
                                <th>Socio</th>
                                <th>MontoPagado</th>
                                <th>MedioPago</th>
                                <th>NumeroOperacion</th>
                                <th>Estado</th>
                                <th>FechaPago</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var pago in Model)
                                {
                                    var badgeClass = pago.Estado == "REGISTRADO"
                                        ? "bg-success"
                                        : pago.Estado == "ANULADO"
                                            ? "bg-danger"
                                            : "bg-secondary";

                                    <tr>
                                        <td>@pago.CodigoPago</td>
                                        <td>@pago.CodigoDeuda</td>
                                        <td>@(string.IsNullOrWhiteSpace(pago.CodigoPuesto) ? "-" : pago.CodigoPuesto)</td>
                                        <td>@(string.IsNullOrWhiteSpace(pago.Socio) ? "-" : pago.Socio)</td>
                                        <td>@pago.MontoPagado.ToString("0.00")</td>
                                        <td>@pago.MedioPago</td>
                                        <td>@(string.IsNullOrWhiteSpace(pago.NumeroOperacion) ? "-" : pago.NumeroOperacion)</td>
                                        <td>
                                            <span class="badge @badgeClass">@pago.Estado</span>
                                        </td>
                                        <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-2">
                                                <a asp-action="Detalle" asp-route-id="@pago.PagoID" class="btn btn-warning btn-sm">Ver Detalle</a>
                                                <a asp-controller="Comprobante" asp-action="Detalle" asp-route-pagoId="@pago.PagoID" class="btn btn-success btn-sm">Ver Comprobante</a>
                                                @if (pago.Estado == "REGISTRADO")
                                                {
                                                    <a asp-action="Anular" asp-route-id="@pago.PagoID" class="btn btn-danger btn-sm">Anular</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center">No hay pagos registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
