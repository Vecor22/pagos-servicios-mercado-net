@model Mercado.PL.GUI.DTO.Response.PagoResponse

@{
    ViewData["Title"] = "Detalle de Pago";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="card-title mb-0">Detalle de Pago</h2>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Volver</a>
                        @if (Model.Estado == "REGISTRADO")
                        {
                            <a asp-action="Anular" asp-route-id="@Model.PagoID" class="btn btn-danger">Anular</a>
                        }
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <tbody>
                            <tr>
                                <th class="table-light w-25">CodigoPago</th>
                                <td>@Model.CodigoPago</td>
                            </tr>
                            <tr>
                                <th class="table-light">CodigoDeuda</th>
                                <td>@Model.CodigoDeuda</td>
                            </tr>
                            <tr>
                                <th class="table-light">Concepto</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.Concepto) ? "-" : Model.Concepto)</td>
                            </tr>
                            <tr>
                                <th class="table-light">CodigoPuesto</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.CodigoPuesto) ? "-" : Model.CodigoPuesto)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Socio</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.Socio) ? "-" : Model.Socio)</td>
                            </tr>
                            <tr>
                                <th class="table-light">MontoPagado</th>
                                <td>@Model.MontoPagado.ToString("0.00")</td>
                            </tr>
                            <tr>
                                <th class="table-light">MedioPago</th>
                                <td>@Model.MedioPago</td>
                            </tr>
                            <tr>
                                <th class="table-light">NumeroOperacion</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.NumeroOperacion) ? "-" : Model.NumeroOperacion)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Estado</th>
                                <td>
                                    @{
                                        var badgeClass = Model.Estado == "REGISTRADO"
                                            ? "bg-success"
                                            : Model.Estado == "ANULADO"
                                                ? "bg-danger"
                                                : "bg-secondary";
                                    }
                                    <span class="badge @badgeClass">@Model.Estado</span>
                                </td>
                            </tr>
                            <tr>
                                <th class="table-light">FechaPago</th>
                                <td>@Model.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th class="table-light">FechaAnulacion</th>
                                <td>@(Model.FechaAnulacion.HasValue ? Model.FechaAnulacion.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            </tr>
                            <tr>
                                <th class="table-light">MotivoAnulacion</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.MotivoAnulacion) ? "-" : Model.MotivoAnulacion)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Usuario que registro</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.UsuarioRegistro) ? "-" : Model.UsuarioRegistro)</td>
                            </tr>
                            <tr>
                                <th class="table-light">Usuario que anulo</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.UsuarioAnulacion) ? "-" : Model.UsuarioAnulacion)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
