@model Mercado.BL.BE.MantenimientoBE
@{ ViewData["Title"] = "Editar Mantenimiento"; }

<h2>&#9998; Editar Mantenimiento — ID: @Model.IdMantenimiento</h2>
<hr />
<div class="row"><div class="col-md-6">
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdMantenimiento" />

    <div class="mb-3">
        <label class="form-label fw-bold">Tipo de Servicio</label>
                <select name="Tipo" class="form-select" required>
                    @foreach (var item in ViewBag.Tipos as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                    {
                        @* La comparación devuelve true o false directamente al atributo *@
                        <option value="@item.Value" selected="@(item.Value == Model.Tipo)">
                            @item.Text
                        </option>
                    }
                </select>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Descripción</label>
        <input asp-for="Descripcion" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Proveedor</label>
        <input asp-for="Proveedor" class="form-control" />
    </div>

    <div class="row">
        <div class="col mb-3">
            <label class="form-label fw-bold">Mes</label>
                    <select name="Mes" class="form-select" required>
                        @foreach (var item in ViewBag.Meses as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                        {
                            @* Razor procesará el booleano: si es true pone el atributo, si es false lo ignora *@
                            <option value="@item.Value" selected="@(item.Value == Model.Mes)">
                                @item.Text
                            </option>
                        }
                    </select>
        </div>
        <div class="col mb-3">
            <label class="form-label fw-bold">Año</label>
            <input asp-for="Anio" type="number" class="form-control" min="2020" required />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Fecha</label>
        <input asp-for="Fecha" type="date" class="form-control" required />
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold">Monto (S/.)</label>
        <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" required />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning">&#10003; Actualizar</button>
        <a asp-action="Index" class="btn btn-secondary">&#8592; Cancelar</a>
    </div>
</form>
</div></div>
