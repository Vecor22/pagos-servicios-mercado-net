@model List<Mercado.BL.BE.MantenimientoBE>
@{ ViewData["Title"] = "Mantenimiento"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>&#128295; Gastos de Mantenimiento</h2>
    <a asp-action="Create" class="btn btn-success">+ Registrar Gasto</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-@TempData["Tipo"] alert-dismissible fade show">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-bordered table-hover table-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tipo</th>
            <th>Descripción</th>
            <th>Mes / Año</th>
            <th>Fecha</th>
            <th>Proveedor</th>
            <th class="text-end">Monto (S/.)</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdMantenimiento</td>
                <td>
                    <span class="badge
                        @(m.Tipo == "Luz"        ? "bg-warning text-dark" :
                          m.Tipo == "Agua"       ? "bg-info text-dark"    :
                          m.Tipo == "Vigilancia" ? "bg-danger"            :
                          m.Tipo == "Limpieza"   ? "bg-success"           : "bg-secondary")">
                        @m.Tipo
                    </span>
                </td>
                <td>@m.Descripcion</td>
                <td>@m.Mes @m.Anio</td>
                <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@m.Proveedor</td>
                <td class="text-end">@m.Monto.ToString("N2")</td>
                <td class="text-center">
                    <a asp-action="Edit"   asp-route-id="@m.IdMantenimiento" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@m.IdMantenimiento" class="btn btn-danger  btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="table-secondary">
            <td colspan="6" class="fw-bold">TOTAL GASTOS</td>
            <td class="text-end fw-bold">S/. @Model.Sum(m => m.Monto).ToString("N2")</td>
            <td></td>
        </tr>
    </tfoot>
</table>
