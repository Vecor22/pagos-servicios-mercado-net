@model Mercado.BL.BE.MantenimientoBE
@{ ViewData["Title"] = "Eliminar Mantenimiento"; }

<h2 class="text-danger">&#9888; Confirmar Eliminación</h2>
<div class="card border-danger" style="max-width:420px;">
    <div class="card-header bg-danger text-white fw-bold">Mantenimiento ID: @Model.IdMantenimiento</div>
    <div class="card-body">
        <p><strong>Tipo:</strong> @Model.Tipo</p>
        <p><strong>Descripción:</strong> @Model.Descripcion</p>
        <p><strong>Proveedor:</strong> @Model.Proveedor</p>
        <p><strong>Período:</strong> @Model.Mes @Model.Anio</p>
        <p><strong>Monto:</strong> S/. @Model.Monto.ToString("N2")</p>
    </div>
</div>
<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.IdMantenimiento" />
    <button type="submit" class="btn btn-danger">&#10007; Sí, Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">&#8592; Cancelar</a>
</form>
