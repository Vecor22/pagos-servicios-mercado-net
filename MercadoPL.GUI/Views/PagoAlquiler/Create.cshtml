@model Mercado.BL.BE.PagoAlquilerBE
@{ ViewData["Title"] = "Registrar Pago"; }

<h2>&#128176; Registrar Pago de Alquiler</h2>
<hr />
<div class="row"><div class="col-md-6">
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-bold">Puesto</label>
        <select name="IdPuesto" class="form-select" required>
            <option value="">-- Seleccione --</option>
            @foreach (var item in ViewBag.Puestos as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
            {
                <option value="@item.Value">@item.Text</option>
            }
        </select>
    </div>

    <div class="row">
        <div class="col mb-3">
            <label class="form-label fw-bold">Mes</label>
            <select name="Mes" class="form-select" required>
                <option value="">-- Seleccione --</option>
                @foreach (var item in ViewBag.Meses as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
        </div>
        <div class="col mb-3">
            <label class="form-label fw-bold">Año</label>
            <input asp-for="Anio" type="number" class="form-control" min="2020" max="2099" required />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Fecha de Pago</label>
        <input asp-for="FechaPago" type="date" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Monto (S/.)</label>
        <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" required />
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold">Estado</label>
                <select name="Estado" class="form-select">
                    @foreach (var item in ViewBag.Estados as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                    {
                        @* Pasamos el booleano directamente al atributo *@
                        <option value="@item.Value" selected="@item.Selected">
                            @item.Text
                        </option>
                    }
                </select>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">&#10003; Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">&#8592; Cancelar</a>
    </div>
</form>
</div></div>
