@{ ViewData["Title"] = $"Reporte Mantenimiento {ViewBag.Anio}"; }

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2>&#128295; Gastos de Mantenimiento — Año @ViewBag.Anio</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&#8592; Volver</a>
</div>

@* ── Tarjetas balance ─────────────────────────────── *@
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-success text-center p-2">
            <div class="fs-4 fw-bold">S/. @(((decimal)ViewBag.TotalIngresos).ToString("N2"))</div>
            <div class="small">Ingresos (Alquileres)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger text-center p-2">
            <div class="fs-4 fw-bold">S/. @(((decimal)ViewBag.TotalGastos).ToString("N2"))</div>
            <div class="small">Egresos (Mantenimiento)</div>
        </div>
    </div>
    <div class="col-md-4">
        @{
            decimal balance = (decimal)ViewBag.Balance;
            string bgBalance = balance >= 0 ? "bg-primary" : "bg-warning";
            string txtBalance = balance >= 0 ? "text-white" : "text-dark";
        }
        <div class="card @bgBalance @txtBalance text-center p-2">
            <div class="fs-4 fw-bold">S/. @balance.ToString("N2")</div>
            <div class="small">Balance Neto @(balance >= 0 ? "(Superávit)" : "(Déficit)")</div>
        </div>
    </div>
</div>

@* ── Resumen por tipo ─────────────────────────────── *@
<h5>Gasto por Tipo de Servicio</h5>
<table class="table table-bordered table-sm mb-4">
    <thead class="table-success">
        <tr>
            <th>Tipo</th>
            <th class="text-end">Total (S/.)</th>
            <th class="text-end">Promedio (S/.)</th>
            <th class="text-center">Cantidad</th>
            <th>% del Total</th>
        </tr>
    </thead>
    <tbody>
        @{
            decimal totalGastos = (decimal)ViewBag.TotalGastos;
        }
        @foreach (var r in ViewBag.ResumenPorTipo as dynamic[] ?? Array.Empty<dynamic>())
        {
            decimal pct = totalGastos > 0 ? ((decimal)r.Total / totalGastos * 100) : 0;
            <tr>
                <td>
                    <span class="badge
                        @(r.Tipo == "Luz"        ? "bg-warning text-dark" :
                          r.Tipo == "Agua"       ? "bg-info text-dark"    :
                          r.Tipo == "Vigilancia" ? "bg-danger"            :
                          r.Tipo == "Limpieza"   ? "bg-success"           : "bg-secondary")">
                        @r.Tipo
                    </span>
                </td>
                <td class="text-end">S/. @(((decimal)r.Total).ToString("N2"))</td>
                <td class="text-end">S/. @(((decimal)r.Promedio).ToString("N2"))</td>
                <td class="text-center">@r.Cantidad</td>
                <td>
                    <div class="progress" style="height:18px;">
                        <div class="progress-bar bg-danger" style="width:@pct.ToString("N0")%">
                            @pct.ToString("N1")%
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="table-secondary fw-bold">
            <td>TOTAL</td>
            <td class="text-end">S/. @totalGastos.ToString("N2")</td>
            <td></td>
            <td class="text-center">
                @((ViewBag.Gastos as IEnumerable<Mercado.BL.BE.MantenimientoBE>)?.Count() ?? 0)
            </td>
            <td>100%</td>
        </tr>
    </tfoot>
</table>

@* ── Detalle completo ─────────────────────────────── *@
<h5>Detalle Completo</h5>
<table class="table table-bordered table-hover table-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tipo</th>
            <th>Descripción</th>
            <th>Proveedor</th>
            <th>Mes</th>
            <th>Fecha</th>
            <th class="text-end">Monto (S/.)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in ViewBag.Gastos as IEnumerable<Mercado.BL.BE.MantenimientoBE> ?? Enumerable.Empty<Mercado.BL.BE.MantenimientoBE>())
        {
            <tr>
                <td>@m.IdMantenimiento</td>
                <td><span class="badge bg-secondary">@m.Tipo</span></td>
                <td>@m.Descripcion</td>
                <td>@m.Proveedor</td>
                <td>@m.Mes</td>
                <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                <td class="text-end">@m.Monto.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
