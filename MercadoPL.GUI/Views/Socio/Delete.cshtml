@model Mercado.BL.BE.SocioBE
@{
    ViewData["Title"] = "Eliminar Socio";
}
<h2 style="color:#cc0000;">Eliminar Socio</h2>
<hr />
<p>¿Está seguro que desea eliminar al siguiente socio?</p>

<table border="1" cellpadding="6" cellspacing="0" style="width:400px; border-collapse:collapse;">
    <tr><td><strong>ID</strong></td><td>@Model.IdSocio</td></tr>
    <tr><td><strong>Nombre</strong></td><td>@Model.Nombre</td></tr>
    <tr><td><strong>DNI</strong></td><td>@Model.Dni</td></tr>
    <tr><td><strong>Telefono</strong></td><td>@Model.Telefono</td></tr>
</table>

<form asp-action="Delete" asp-route-id="@Model.IdSocio" method="post" style="margin-top:16px;">
    @Html.AntiForgeryToken()
    <button type="submit"
            style="padding:6px 16px; background:#cc0000; color:#fff;
                   border:1px solid #900; font-size:13px; cursor:pointer;">
        Confirmar Eliminacion
    </button>
    &nbsp;
    <a href="/Socio" style="padding:6px 14px; background:#666; color:#fff;
       text-decoration:none; border:1px solid #444; font-size:13px;">
        Cancelar
    </a>
</form>
