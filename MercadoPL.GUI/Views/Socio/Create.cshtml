@model Mercado.BL.BE.SocioBE
@{
    ViewData["Title"] = "Nuevo Socio";
}
<h2>Registrar Nuevo Socio</h2>
<hr />

<form asp-action="Create" method="post" style="max-width:500px;">
    @Html.AntiForgeryToken()
    <div style="margin-bottom:12px;">
        <label><strong>Nombre:</strong></label>
        <input name="Nombre" value="@Model?.Nombre" required
               style="width:100%; padding:6px; border:1px solid #ccc; margin-top:4px;" />
    </div>
    <div style="margin-bottom:12px;">
        <label><strong>DNI:</strong></label>
        <input name="Dni" value="@Model?.Dni" required maxlength="8"
               style="width:100%; padding:6px; border:1px solid #ccc; margin-top:4px;" />
    </div>
    <div style="margin-bottom:12px;">
        <label><strong>Telefono:</strong></label>
        <input name="Telefono" value="@Model?.Telefono"
               style="width:100%; padding:6px; border:1px solid #ccc; margin-top:4px;" />
    </div>
    <div style="margin-top:16px;">
        <button type="submit"
                style="padding:6px 16px; background:#003366; color:#fff;
                       border:1px solid #002244; font-size:13px; cursor:pointer;">
            Guardar
        </button>
        &nbsp;
        <a href="/Socio" style="padding:6px 14px; background:#666; color:#fff;
           text-decoration:none; border:1px solid #444; font-size:13px;">
            Cancelar
        </a>
    </div>
</form>
