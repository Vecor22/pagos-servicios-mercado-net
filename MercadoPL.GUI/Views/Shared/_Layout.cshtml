<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Mercado</title>
    <link rel="stylesheet" href="~/lib/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    &#127978; Sistema Mercado
                </a>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Socio" asp-action="Index">Socios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Puesto" asp-action="Index">Puestos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PagoAlquiler" asp-action="Index">Pagos Alquiler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Mantenimiento" asp-action="Index">Mantenimiento</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reporte" asp-action="Index">&#128202; Reportes</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted mt-4">
        <div class="container" style="padding:10px 0; font-size:12px;">
            &copy; @DateTime.Now.Year &mdash; Sistema de Administracion de Mercado &mdash; 
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
