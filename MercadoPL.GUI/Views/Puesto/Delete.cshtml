@model Mercado.BL.BE.PuestoBE
@{
    ViewData["Title"] = "Eliminar Puesto";
}
<h2 style="color:#cc0000;">Eliminar Puesto</h2>
<hr />
<p>¿Está seguro que desea eliminar el siguiente puesto?</p>

<table border="1" cellpadding="6" cellspacing="0" style="width:400px; border-collapse:collapse;">
    <tr><td><strong>ID</strong></td><td>@Model.IdPuesto</td></tr>
    <tr><td><strong>Codigo</strong></td><td>@Model.Codigo</td></tr>
    <tr><td><strong>Sector</strong></td><td>@Model.Sector</td></tr>
    <tr><td><strong>Socio</strong></td><td>@Model.NombreSocio</td></tr>
</table>

<form asp-action="Delete" asp-route-id="@Model.IdPuesto" method="post" style="margin-top:16px;">
    @Html.AntiForgeryToken()
    <button type="submit"
            style="padding:6px 16px; background:#cc0000; color:#fff;
                   border:1px solid #900; font-size:13px; cursor:pointer;">
        Confirmar Eliminacion
    </button>
    &nbsp;
    <a href="/Puesto" style="padding:6px 14px; background:#666; color:#fff;
       text-decoration:none; border:1px solid #444; font-size:13px;">
        Cancelar
    </a>
</form>
