@model Mercado.BL.BE.PuestoBE
@{
    ViewData["Title"] = "Editar Puesto";
}
<h2>Editar Puesto</h2>
<hr />

<form asp-action="Edit" asp-route-id="@Model.IdPuesto" method="post" style="max-width:500px;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="IdPuesto" value="@Model.IdPuesto" />
    <div style="margin-bottom:12px;">
        <label><strong>Codigo:</strong></label>
        <input name="Codigo" value="@Model.Codigo" required
               style="width:100%; padding:6px; border:1px solid #ccc; margin-top:4px;" />
    </div>
    <div style="margin-bottom:12px;">
        <label><strong>Sector:</strong></label>
        <input name="Sector" value="@Model.Sector"
               style="width:100%; padding:6px; border:1px solid #ccc; margin-top:4px;" />
    </div>
    <div style="margin-bottom:12px;">
        <label><strong>Socio:</strong></label>
        @Html.DropDownList("IdSocio", (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Socios,
            "-- Sin socio --",
            new { style = "width:100%; padding:6px; border:1px solid #ccc; margin-top:4px;" })
    </div>
    <div style="margin-top:16px;">
        <button type="submit"
                style="padding:6px 16px; background:#e8a000; color:#fff;
                       border:1px solid #c07800; font-size:13px; cursor:pointer;">
            Actualizar
        </button>
        &nbsp;
        <a href="/Puesto" style="padding:6px 14px; background:#666; color:#fff;
           text-decoration:none; border:1px solid #444; font-size:13px;">
            Cancelar
        </a>
    </div>
</form>
